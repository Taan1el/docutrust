{
  "name": "docutrust",
  "version": "1.0.0",
  "description": "Multi-party document signing with ECDSA signatures, canonical hashing and tamper detection",
  "private": true,
  "type": "module",
  "homepage": "https://taan1el.github.io/docutrust/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taan1el/docutrust.git"
  },
  "bugs": {
    "url": "https://github.com/Taan1el/docutrust/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:pages": "npm run build:pages --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "npm run lint --workspace=server",
    "lint:client": "npm run lint --workspace=client"
  },
  "keywords": [
    "digital-signatures",
    "cryptography",
    "pki",
    "ecdsa",
    "sha256",
    "e-signatures",
    "react19",
    "sqlite-wal"
  ],
  "author": "Taaniel Vananurm",
  "license": "MIT"
}
